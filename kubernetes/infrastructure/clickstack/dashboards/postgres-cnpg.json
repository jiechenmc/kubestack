      "w": 12,
      "h": 7,
      "config": {
        "name": "Postgres Errors by Pod",
        "source": "6afa34916fc6252e29615082",
        "displayType": "table",
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "Logs"
          }
        ],
        "where": "ResourceAttributes['k8s.pod.name'] LIKE 'pg-%' AND SeverityText IN ('ERROR', 'error', 'FATAL', 'fatal', 'CRITICAL', 'critical')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        },
        "groupBy": "ResourceAttributes['k8s.pod.name']",
        "orderBy": "`Logs` DESC"
      }
    },
