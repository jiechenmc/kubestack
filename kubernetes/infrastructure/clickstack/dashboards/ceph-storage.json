        "where": "ResourceAttributes['k8s.namespace.name'] = 'rook-ceph' AND (SeverityText IN ('ERROR', 'error', 'FATAL', 'fatal', 'CRITICAL', 'critical') OR SeverityText IN ('WARN', 'warn', 'WARNING', 'warning'))",
