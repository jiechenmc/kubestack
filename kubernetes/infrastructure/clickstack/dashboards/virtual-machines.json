      "y": 18,
      "w": 12,
      "h": 7,
      "config": {
        "name": "KubeVirt Errors by Service",
        "source": "6afa34916fc6252e29615082",
        "displayType": "table",
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "alias": "Logs"
          }
        ],
        "where": "ResourceAttributes['k8s.namespace.name'] IN ('kubevirt', 'cdi', 'vms', 'vm-images') AND SeverityText IN ('ERROR', 'error', 'FATAL', 'fatal', 'CRITICAL', 'critical')",
        "whereLanguage": "sql",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        },
        "groupBy": "ServiceName",
        "orderBy": "`Logs` DESC"
      }
